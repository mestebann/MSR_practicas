Panels:
  - Class: rviz_common/Displays
    Help Height: 98
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /RobotModel1
        - /TF1
        - /Image1
        - /Image2
      Splitter Ratio: 0.5
    Tree Height: 210
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
