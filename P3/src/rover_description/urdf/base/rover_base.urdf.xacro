<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="rover_base" params="prefix base_height:=1.00000">

        <!-- Frame en el suelo -->
        <link name="${prefix}base_footprint"/>

        <!-- Frame base del rover -->
        <link name="${prefix}base_link"/>

        <joint name="${prefix}base_footprint_joint" type="fixed">
            <parent link="${prefix}base_footprint"/>
            <child link="${prefix}base_link"/>
            <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
        </joint>

        <!-- Chasis principal -->
        <link name="${prefix}Chasis_link">
            <collision name="Chasis_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.dae"
                        scale="0.75000 0.37500 0.10000"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="150.00000"/>
                <inertia ixx="187.06638" ixy="-0.01613" ixz="0.00145"
                        iyy="48.14865"  iyz="0.01146"
                        izz="177.87628"/>
            </inertial>

            <visual name="Chasis">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.dae"
                        scale="0.75000 0.37500 0.10000"/>
                </geometry>
                <material name="Material.004"/>
            </visual>
        </link>

        <joint name="${prefix}base_link_to_Chasis_link_joint" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="${prefix}Chasis_link"/>
        <origin xyz="0 0 0" rpy="0 0 -1.57080"/>
        </joint>

        <!-- Compartimento 1 -->
        <link name="${prefix}Compartimento1_link">
            <collision name="Compartimento1_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.002.dae"
                        scale="1.15000 0.00946 0.23944"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="1.00000"/>
                <inertia ixx="0.45994" ixy="0.00000" ixz="0.00000"
                        iyy="0.01914" iyz="0.00000"
                        izz="0.44086"/>
            </inertial>

            <visual name="Compartimento1">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.002.dae"
                        scale="1.15000 0.00946 0.23944"/>
                </geometry>
                <material name="Material.016"/>
            </visual>
        </link>

        <joint name="${prefix}Compartimento1_link_joint" type="fixed">
            <parent link="${prefix}Chasis_link"/>
            <child link="${prefix}Compartimento1_link"/>
            <origin xyz="-0.70760 -0.94501 0.24745" rpy="0.00000 0.00000 1.57080"/>
        </joint>

        <!-- Compartimento 2 -->
        <link name="${prefix}Compartimento2_link">
            <collision name="Compartimento2_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.003.dae"
                        scale="1.15000 0.01000 0.23300"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="1.00000"/>
                <inertia ixx="0.45893" ixy="0.00000" ixz="0.00000"
                        iyy="0.01813" iyz="0.00000"
                        izz="0.44087"/>
            </inertial>

            <visual name="Compartimento2">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.003.dae"
                        scale="1.15000 0.01000 0.23300"/>
                </geometry>
                <material name="Material.019"/>
            </visual>

        </link>

        <joint name="${prefix}Compartimento2_link_joint" type="fixed">
            <parent link="${prefix}Chasis_link"/>
            <child link="${prefix}Compartimento2_link"/>
            <origin xyz="0.70760 -0.94468 0.24747" rpy="0.00000 0.00000 1.57080"/>
        </joint>

        <!-- Compartimento 3 -->
        <link name="${prefix}Compartimento3_link">
            <collision name="Compartimento3_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.004.dae"
                        scale="0.70000 0.01000 0.23300"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="1.00000"/>
                <inertia ixx="0.01813" ixy="0.00000" ixz="0.00000"
                        iyy="0.18143" iyz="0.00000"
                        izz="0.16337"/>
            </inertial>

            <visual name="Compartimento3">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.004.dae"
                        scale="0.70000 0.01000 0.23300"/>
                </geometry>
                <material name="Material.018"/>
            </visual>

        </link>

        <joint name="${prefix}Compartimento3_link_joint" type="fixed">
            <parent link="${prefix}Chasis_link"/>
            <child link="${prefix}Compartimento3_link"/>
            <origin xyz="0.00000 0.17858 0.24745" rpy="0.00000 0.00000 0.00000"/>
        </joint>

        <!-- Compartimento 4 -->
        <link name="${prefix}Compartimento4_link">
            <collision name="Compartimento4_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.005.dae"
                        scale="0.70000 0.01000 0.23300"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="1.00000"/>
                <inertia ixx="0.01813" ixy="0.00000" ixz="0.00000"
                        iyy="0.18143" iyz="0.00000"
                        izz="0.16337"/>
            </inertial>

            <visual name="Compartimento4">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.005.dae"
                        scale="0.70000 0.01000 0.23300"/>
                </geometry>
                <material name="Material.017"/>
            </visual>
        </link>

        <joint name="${prefix}Compartimento4_link_joint" type="fixed">
            <parent link="${prefix}Chasis_link"/>
            <child link="${prefix}Compartimento4_link"/>
            <origin xyz="0.00000 -2.06753 0.24745" rpy="0.00000 0.00000 0.00000"/>
        </joint>

    </xacro:macro>

</robot>
