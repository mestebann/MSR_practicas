<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="scara" params="prefix parent *origin">

        <!-- Brazo 1 -->
        <link name="${prefix}Brazo1_link">
            <collision name="${prefix}Brazo1_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.60693 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.dae"
                        scale="1.00000 0.23300 0.12300"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.60693 0.00000 0.00000"/>
                <mass value="3.00000"/>
                <inertia ixx="0.76033" ixy="0.00000" ixz="0.00000"
                        iyy="0.05558" iyz="0.00000"
                        izz="0.78565"/>
            </inertial>

            <visual name="${prefix}Brazo1_visual">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.60693 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.dae"
                        scale="1.00000 0.23300 0.12300"/>
                </geometry>
                <material name="Material.014"/>
            </visual>
        </link>

        <joint name="${prefix}Brazo1_link_joint" type="revolute">
            <parent link="${parent}"/>
            <child link="${prefix}Brazo1_link"/>
            <xacro:insert_block name="origin"/>
            <axis xyz="0.00000 0.00000 1.00000"/>
            <limit lower="-3.00000" upper="3.00000" effort="1000" velocity="100.0"/>
        </joint>

        <!-- Brazo 2 -->
        <link name="${prefix}Brazo2_link">
            <collision name="${prefix}Brazo2_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.51995 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.013.dae"
                        scale="0.67571 0.18837 0.07006"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.51995 0.00000 0.00000"/>
                <mass value="1.50000"/>
                <inertia ixx="0.17258" ixy="0.00000" ixz="0.00000"
                        iyy="0.01568" iyz="0.00000"
                        izz="0.18335"/>
            </inertial>

            <visual name="${prefix}Brazo2_visual">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.51995 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.013.dae"
                        scale="0.67571 0.18837 0.07006"/>
                </geometry>
                <material name="Material.007"/>
            </visual>
        </link>

        <joint name="${prefix}Brazo2_link_joint" type="revolute">
            <parent link="${prefix}Brazo1_link"/>
            <child link="${prefix}Brazo2_link"/>
            <origin rpy="0.00000 0.00000 0.00000" xyz="1.43431 0.00000 0.19480"/>
            <axis xyz="0.00000 0.00000 1.00000"/>
            <limit lower="-2.00000" upper="2.00000" effort="1000" velocity="100.0"/>
        </joint>

        <!-- Brazo 3 -->
        <link name="${prefix}Brazo3_link">
            <collision name="${prefix}Brazo3_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.016.dae"
                        scale="0.09429 0.09429 0.24632"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="1.00000"/>
                <inertia ixx="0.02243" ixy="0.00000" ixz="0.00000"
                        iyy="0.02243" iyz="0.00000"
                        izz="0.00442"/>
            </inertial>

            <visual name="${prefix}Brazo3_visual">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.016.dae"
                        scale="0.09429 0.09429 0.24632"/>
                </geometry>
                <material name="Material.015"/>
            </visual>
        </link>

        <joint name="${prefix}Brazo3_link_joint" type="revolute">
            <parent link="${prefix}Brazo2_link"/>
            <child link="${prefix}Brazo3_link"/>
            <origin rpy="0.00000 0.00000 -1.57080" xyz="1.01188 0.00000 -0.18676"/>
            <axis xyz="0.00000 0.00000 1.00000"/>
            <limit lower="-1.57000" upper="1.57000" effort="1000" velocity="100.0"/>
        </joint>

        <!-- Brazo 4 -->
        <link name="${prefix}Brazo4_link">
            <collision name="${prefix}Brazo4_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.60807"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.018.dae"
                        scale="0.06875 0.06875 0.88360"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="1.00000"/>
                <inertia ixx="0.26142" ixy="0.00000" ixz="0.00000"
                        iyy="0.26142" iyz="0.00000"
                        izz="0.00235"/>
            </inertial>

            <visual name="${prefix}Brazo4_visual">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.60807"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cylinder.018.dae"
                        scale="0.06875 0.06875 0.88360"/>
                </geometry>
                <material name="Material.011"/>
            </visual>
        </link>

        <joint name="${prefix}Brazo4_link_joint" type="prismatic">
            <parent link="${prefix}Brazo3_link"/>
            <child link="${prefix}Brazo4_link"/>
            <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 -0.00004 -0.14111"/>
            <axis xyz="0.00000 0.00000 1.00000"/>
            <limit lower="-1.50000" upper="0.50000" effort="1000" velocity="100.0"/>
        </joint>

        <!-- Brazo 5 -->
        <link name="${prefix}Brazo5_link">
            <collision name="${prefix}Brazo5_collision">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.029.dae"
                        scale="0.53959 2.07906 0.16559"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="1.00000"/>
                <inertia ixx="0.00664" ixy="0.00000" ixz="0.00000"
                        iyy="0.09062" iyz="0.00000"
                        izz="0.09612"/>
            </inertial>

            <visual name="${prefix}Brazo5_visual">
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.029.dae"
                        scale="0.53959 2.07906 0.16559"/>
                </geometry>
                <material name="Material.010"/>
            </visual>
        </link>

        <joint name="${prefix}Brazo5_link_joint" type="fixed">
            <parent link="${prefix}Brazo4_link"/>
            <child link="${prefix}Brazo5_link"/>
            <origin rpy="0.00000 0.00000 1.57080" xyz="0.00000 0.00000 -0.28645"/>
        </joint>


        <transmission name="${prefix}Brazo1_link_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Brazo1_link_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Brazo1_link_motor">
            <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <transmission name="${prefix}Brazo2_link_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Brazo2_link_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Brazo2_link_motor">
            <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <transmission name="${prefix}Brazo3_link_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Brazo3_link_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Brazo3_link_motor">
            <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <transmission name="${prefix}Brazo4_link_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Brazo4_link_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Brazo4_link_motor">
            <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

    </xacro:macro>

</robot>
