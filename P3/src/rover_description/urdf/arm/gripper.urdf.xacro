<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="gripper" params="prefix parent">

        <!-- Gripper 1 -->
        <link name="${prefix}Gripper1_link">
            <collision name="${prefix}Gripper1_collision">
                <origin rpy="-1.57080 0.00000 1.57080" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.031.dae"
                        scale="0.53728 0.20000 1.00000"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="0.50000"/>
                <inertia ixx="0.01342" ixy="0.00000" ixz="0.00000"
                        iyy="0.01083" iyz="0.00000"
                        izz="0.00342"/>
            </inertial>

            <visual name="${prefix}Gripper1_visual">
                <origin rpy="-1.57080 0.00000 1.57080" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.031.dae"
                        scale="0.53728 0.20000 1.00000"/>
                </geometry>
                <material name="Material.012"/>
            </visual>
        </link>

        <joint name="${prefix}Gripper1_link_joint" type="prismatic">
            <parent link="${parent}"/>
            <child link="${prefix}Gripper1_link"/>
            <origin rpy="1.57080 1.57080 0.00000" xyz="0.00521 0.50000 -0.28960"/>
            <axis xyz="0.00000 0.00000 1.00000"/>
            <limit lower="0.00000" upper="0.30000" effort="1000" velocity="100.0"/>
        </joint>

        <!-- Gripper 2 -->
        <link name="${prefix}Gripper2_link">
            <collision name="${prefix}Gripper2_collision">
                <origin rpy="-1.57080 0.00000 1.57080" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.032.dae"
                        scale="0.53728 0.20000 1.00000"/>
                </geometry>
            </collision>

            <inertial>
                <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
                <mass value="0.50000"/>
                <inertia ixx="0.01342" ixy="0.00000" ixz="0.00000"
                        iyy="0.01083" iyz="0.00000"
                        izz="0.00342"/>
            </inertial>

            <visual name="${prefix}Gripper2_visual">
                <origin rpy="-1.57080 0.00000 1.57080" xyz="0.00000 0.00000 0.00000"/>
                <geometry>
                    <mesh filename="package://rover_description/meshes/dae/Cube.032.dae"
                        scale="0.53728 0.20000 1.00000"/>
                </geometry>
                <material name="Material.013"/>
            </visual>
        </link>

        <joint name="${prefix}Gripper2_link_joint" type="prismatic">
            <parent link="${parent}"/>
            <child link="${prefix}Gripper2_link"/>
            <origin rpy="1.57080 1.57080 0.00000" xyz="0.00520 -0.50000 -0.28960"/>
            <axis xyz="0.00000 0.00000 1.00000"/>
            <limit lower="-0.30000" upper="0.00000" effort="1000" velocity="100.0"/>
        </joint>

        <transmission name="${prefix}Gripper1_link_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Gripper1_link_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Gripper1_link_motor">
            <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <transmission name="${prefix}Gripper2_link_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}Gripper2_link_joint">
            <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}Gripper2_link_motor">
            <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

    </xacro:macro>

</robot>
